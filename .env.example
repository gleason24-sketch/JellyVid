# Copy to .env.local and fill in. Nothing here is NEXT_PUBLIC_ except the site URL,
# so none of it can reach the browser bundle.

# Supabase (Postgres + the RPC access layer). The anon key is safe to hold here:
# every table is RLS-locked and every function also demands JELLYVID_DB_SECRET.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared secret the SECURITY DEFINER functions check. Rotate with jv_set_app_secret.
JELLYVID_DB_SECRET=
# Signs the session cookie.
JELLYVID_SESSION_SECRET=
# Protects /api/reconcile from being run by anyone.
JELLYVID_CRON_SECRET=

# Higgsfield API credentials as issued by console.higgsfield.ai: "keyId:keySecret".
HIGGSFIELD_API_KEY=
# Or, equivalently, as two variables:
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Optional. Without these the pricing page says card payments are off, plainly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
JELLYVID_SUPPORT_EMAIL=support@jellyvid.com

# Set HF_MOCK=1 to run the whole pipeline against local fixtures at zero cost.
